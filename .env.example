# Provision a Postgres database in Vercel: Storage tab -> Create Database ->
# Postgres, then Connect it to this project. That auto-injects
# DATABASE_URL / POSTGRES_URL as environment variables on the Vercel project.
#
# For local `npm run seed` or `vercel dev`, copy this file to .env.local and
# fill in the same connection string (Storage -> your database -> .env.local tab).
DATABASE_URL=

# Any long random string, used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase -> Settings -> API -> service_role key. Used server-side only
# (creating/deleting Supabase Auth users on signup).
SUPABASE_SERVICE_ROLE_KEY=

# Meta App -> Settings -> Basic -> App Secret. Used server-side only (OAuth
# code exchange for Facebook/Instagram connections).
META_APP_SECRET=

# Cloudflare dashboard -> R2 -> your bucket. Used for video uploads (bucket
# must have Public Access enabled; R2_PUBLIC_URL is that public base URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
